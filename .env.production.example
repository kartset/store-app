# ==============================================================================
# Production Environment Configuration Template (Coolify / Docker)
# ==============================================================================
# Replace "<YOUR_VPS_IP>" with your server IP (e.g., 123.45.67.89) or custom domain.

# --- Database Configuration (PostgreSQL) ---
POSTGRES_DB=store_db
POSTGRES_USER=store_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# --- Backend Configuration (Django + Gunicorn) ---
DEBUG=False
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace_with_a_strong_django_secret_key

# Comma-separated list of permitted host headers
ALLOWED_HOSTS=api.<YOUR_VPS_IP>.sslip.io,app.<YOUR_VPS_IP>.sslip.io,store.<YOUR_VPS_IP>.sslip.io,localhost

# Database connection URL (auto-generated in docker-compose.coolify.yml)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# CORS & CSRF: Comma-separated allowed web origins
CORS_ALLOWED_ORIGINS=https://app.<YOUR_VPS_IP>.sslip.io,https://store.<YOUR_VPS_IP>.sslip.io
CSRF_TRUSTED_ORIGINS=https://api.<YOUR_VPS_IP>.sslip.io,https://app.<YOUR_VPS_IP>.sslip.io,https://store.<YOUR_VPS_IP>.sslip.io

# --- Frontend Build Configuration (React + Vite) ---
# Embeds the production API URL into frontend static assets at build time
VITE_API_URL=https://api.<YOUR_VPS_IP>.sslip.io

# --- Marketing Website Build Configuration (Next.js) ---
NEXT_PUBLIC_API_URL=https://api.<YOUR_VPS_IP>.sslip.io
NEXT_PUBLIC_DASHBOARD_URL=https://app.<YOUR_VPS_IP>.sslip.io
