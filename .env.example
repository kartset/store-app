# ==============================================================================
# Local Development Environment Configuration Template
# ==============================================================================
# Copy this file to .env: `cp .env.example .env`

# Database Configuration (PostgreSQL)
POSTGRES_USER=store_user
POSTGRES_PASSWORD=store_password
POSTGRES_DB=store_db

# Backend Configuration (Django)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DEBUG=True
SECRET_KEY=local-dev-secret-key-storecraft-retail-erp-change-in-prod

# Model Context Protocol (MCP) Service Configuration
# In local Docker Compose, use http://mcp:8080. For local host process, use http://localhost:8080
MCP_SERVER_URL=http://localhost:8080
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Frontend Configuration (Vite + React)
VITE_API_URL=http://localhost:8000

# Website Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173

# Optional: External AI Provider Keys for Retail Copilot Online Mode
OPENROUTER_API_KEY=
OPENAI_API_KEY=
